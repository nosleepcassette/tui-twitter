AUTH_TOKEN=your_auth_token_here
CT0=your_ct0_here

# Optional alternatives:
# TWITTER_AUTH_TOKEN=your_auth_token_here
# TWITTER_CT0=your_ct0_here

# Optional browser profile discovery:
# TWITTER_FIREFOX_PROFILE=default-release
# TWITTER_CHROME_PROFILE=Default

# Optional browser source controls:
# TWITTER_ALLOW_FIREFOX=true
# TWITTER_ALLOW_CHROME=true

# Optional image mode:
# X_IMAGE_MODE=auto # auto | kitty | off
