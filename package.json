{
  "name": "tui-twitter",
  "version": "1.0.0",
  "description": "Terminal Twitter/X client with Bird-style cookie auth and OpenTUI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "query-ids:update": "\"$HOME/.bun/bin/bun\" run scripts/update-query-ids.ts"
  },
  "bin": {
    "tui-twitter": "./tui-twitter"
  },
  "keywords": [
    "twitter",
    "x.com",
    "terminal",
    "tui",
    "opentui"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@opentui/core": "^0.1.90",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
